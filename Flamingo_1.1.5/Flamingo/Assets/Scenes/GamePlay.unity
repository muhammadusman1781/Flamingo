--- !u!114 &1172447227
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1172447225}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 26dfc69fac22a33439c6e5d21851c773, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  gradesQuiz:
  - grade: 11
    levels:
    - levelNumber: 1
      questions:
      - question: "\u0645\u0627 \u0627\u0644\u0641\u0643\u0631\u0629 \u0627\u0644\u0631\u0626\u064A\u0633\u0629
          \u0627\u0644\u062A\u064A \u062A\u0646\u0627\u0648\u0644\u0647\u0627 \u0627\u0644\u0646\u0635
          \u0641\u064A \u062F\u0631\u0633 \u0645\u0643\u0627\u0631\u0645 \u0627\u0644\u0623\u062E\u0644\u0627\u0642\u061F"
        answer:
        - "\u0623\u0647\u0645\u064A\u0629 \u0627\u0644\u062A\u0641\u0648\u0642 \u0627\u0644\u062F\u0631\u0627\u0633\u064A"
        - "\u062F\u0648\u0631 \u0627\u0644\u0639\u0644\u0645 \u0641\u064A \u0628\u0646\u0627\u0621
          \u0627\u0644\u0623\u0645\u0629"
        - "c) \u0636\u0631\u0648\u0631\u0629 \u0627\u0644\u062A\u062D\u0644\u064A
          \u0628\u0627\u0644\u0623\u062E\u0644\u0627\u0642 \u0627\u0644\u0643\u0631\u064A\u0645\u0629"
        - "\u0641\u0636\u0644 \u0627\u0644\u0635\u0644\u0627\u0629 \u0641\u064A \u0627\u0644\u0625\u0633\u0644\u0627\u0645"
        rightAnswer: "c) \u0636\u0631\u0648\u0631\u0629 \u0627\u0644\u062A\u062D\u0644\u064A
          \u0628\u0627\u0644\u0623\u062E\u0644\u0627\u0642 \u0627\u0644\u0643\u0631\u064A\u0645\u0629"
      - question: "\u0645\u0627 \u0647\u0648 \u062A\u0639\u0631\u064A\u0641 \u0627\u0644\u062A\u063A\u0630\u064A\u0629
          \u0641\u064A \u0639\u0644\u0645 \u0627\u0644\u0623\u062D\u064A\u0627\u0621\u061F"
        answer:
        - "\u0639\u0645\u0644\u064A\u0629 \u0646\u0642\u0644 \u0627\u0644\u062F\u0645"
        - "\u0639\u0645\u0644\u064A\u0629 \u0627\u0645\u062A\u0635\u0627\u0635 \u0627\u0644\u0636\u0648\u0621"
        - "c) \u0639\u0645\u0644\u064A\u0629 \u062D\u0635\u0648\u0644 \u0627\u0644\u0643\u0627\u0626\u0646
          \u0627\u0644\u062D\u064A \u0639\u0644\u0649 \u0627\u0644\u0637\u0627\u0642\u0629
          \u0645\u0646 \u0627\u0644\u062A\u0641\u0627\u0639\u0644\u0627\u062A \u0627\u0644\u0643\u064A\u0645\u064A\u0627\u0626\u064A\u0629"
        - "\u0639\u0645\u0644\u064A\u0629 \u062A\u062D\u0648\u064A\u0644 \u0627\u0644\u0645\u0627\u0621
          \u0625\u0644\u0649 \u0637\u0627\u0642\u0629"
        rightAnswer: "c) \u0639\u0645\u0644\u064A\u0629 \u062D\u0635\u0648\u0644
          \u0627\u0644\u0643\u0627\u0626\u0646 \u0627\u0644\u062D\u064A \u0639\u0644\u0649
          \u0627\u0644\u0637\u0627\u0642\u0629 \u0645\u0646 \u0627\u0644\u062A\u0641\u0627\u0639\u0644\u0627\u062A
          \u0627\u0644\u0643\u064A\u0645\u064A\u0627\u0626\u064A\u0629"
      - question: "\u0645\u0627 \u0627\u0644\u062C\u0633\u064A\u0645 \u0627\u0644\u0630\u064A
          \u0627\u0643\u062A\u0634\u0641 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
          \u0623\u0646\u0627\u0628\u064A\u0628 \u0627\u0644\u062A\u0641\u0631\u064A\u063A
          \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064A\u061F"
        answer:
        - "\u0627\u0644\u0628\u0631\u0648\u062A\u0648\u0646"
        - "\u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646"
        - "\u0627\u0644\u0646\u064A\u0648\u062A\u0631\u0648\u0646"
        - "\u0627\u0644\u0646\u0648\u0627\u0629"
        rightAnswer: "\u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646"
      - question: Which of the following is the correct structure of a basic English
          sentence?
        answer:
        - Verb + Subject + Object
        - Object + Verb + Subject
        - Adverb + Verb + Subject
        - d) Subject + Verb + Complement
        rightAnswer: d) Subject + Verb + Complement
      - question: "\u0645\u0627 \u0627\u0644\u0645\u0642\u0635\u0648\u062F \u0628\u0625\u062F\u063A\u0627\u0645
          \u0627\u0644\u0645\u062A\u0645\u0627\u062B\u0644\u064A\u0646\u061F"
        answer:
        - "\u0625\u062F\u062E\u0627\u0644 \u0627\u0644\u062D\u0631\u0641 \u0641\u064A
          \u062D\u0631\u0641 \u0622\u062E\u0631 \u0645\u062E\u0627\u0644\u0641 \u0644\u0647
          \u0641\u064A \u0627\u0644\u0635\u0641\u0627\u062A"
        - "\u0625\u062F\u063A\u0627\u0645 \u062D\u0631\u0641\u064A\u0646 \u0645\u062E\u062A\u0644\u0641\u064A\u0646
          \u0641\u064A \u0627\u0644\u0645\u062E\u0631\u062C \u0648\u0627\u0644\u0635\u0641\u0629"
        - "c) \u0625\u062F\u063A\u0627\u0645 \u062D\u0631\u0641\u064A\u0646 \u0645\u062A\u0645\u0627\u062B\u0644\u064A\u0646
          \u0641\u064A \u0627\u0644\u0645\u062E\u0631\u062C \u0648\u0627\u0644\u0635\u0641\u0629
          \u0641\u064A\u0635\u064A\u0631\u0627\u0646 \u062D\u0631\u0641\u0627\u064B
          \u0648\u0627\u062D\u062F\u0627\u064B \u0645\u0634\u062F\u062F\u0627\u064B"
        - "\u0625\u062F\u063A\u0627\u0645 \u0627\u0644\u062D\u0631\u0641 \u0627\u0644\u0623\u0648\u0644
          \u0641\u064A \u0633\u0643\u0648\u0646 \u0627\u0644\u062B\u0627\u0646\u064A"
        rightAnswer: "c) \u0625\u062F\u063A\u0627\u0645 \u062D\u0631\u0641\u064A\u0646
          \u0645\u062A\u0645\u0627\u062B\u0644\u064A\u0646 \u0641\u064A \u0627\u0644\u0645\u062E\u0631\u062C
          \u0648\u0627\u0644\u0635\u0641\u0629 \u0641\u064A\u0635\u064A\u0631\u0627\u0646
          \u062D\u0631\u0641\u0627\u064B \u0648\u0627\u062D\u062F\u0627\u064B \u0645\u0634\u062F\u062F\u0627\u064B"
      - question: "\u0645\u0627 \u0642\u064A\u0645\u0629 (1) log\u2081\u2080\u061F"
        answer:
        - 1
        - 0
        - "\u063A\u064A\u0631 \u0645\u0639\u0631\u0641"
        - 10
        rightAnswer: 0
      - question: "\u0645\u0627 \u0627\u0644\u0648\u062D\u062F\u0629 \u0627\u0644\u0641\u064A\u0632\u064A\u0627\u0626\u064A\u0629
          \u0627\u0644\u062A\u064A \u062A\u064F\u0633\u062A\u062E\u062F\u0645 \u0644\u0642\u064A\u0627\u0633
          \u0627\u0644\u0625\u0632\u0627\u062D\u0629\u061F"
        answer:
        - "\u062B\u0627\u0646\u064A\u0629"
        - "\u0645\u062A\u0631"
        - "\u0643\u063A"
        - "\u0646\u064A\u0648\u062A\u0646"
        rightAnswer: "\u0645\u062A\u0631"
    - levelNumber: 2
      questions:
      - question: "\u0623\u064A \u0627\u0644\u0623\u0641\u0639\u0627\u0644 \u0627\u0644\u0622\u062A\u064A\u0629
          \u064A\u064F\u0639\u062F \u0645\u0646 \u0623\u062E\u0648\u0627\u062A \u0643\u0627\u0646
          \u0648\u064A\u0639\u0645\u0644 \u0639\u0645\u0644\u0647\u0627\u061F"
        answer:
        - "\u062C\u0644\u0633"
        - "\u0643\u062A\u0628"
        - "c) \u0623\u0635\u0628\u062D"
        - "\u0645\u0634\u0649"
