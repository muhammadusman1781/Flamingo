        answer:
        - "\u0627\u0644\u062C\u0645\u0627\u0644"
        - "\u0627\u0644\u0634\u062C\u0627\u0639\u0629"
        - "\u0625\u0635\u0627\u0628\u0629 \u0627\u0644\u062D\u0642 \u0628\u0627\u0644\u0639\u0642\u0644
          \u0648\u0627\u0644\u0639\u0644\u0645"
        - "\u0627\u0644\u0635\u062F\u0642"
        rightAnswer: "\u0625\u0635\u0627\u0628\u0629 \u0627\u0644\u062D\u0642 \u0628\u0627\u0644\u0639\u0642\u0644
          \u0648\u0627\u0644\u0639\u0644\u0645"
      - question: "\u06331: \u0623\u064A \u0645\u0646 \u0627\u0644\u0623\u0639\u062F\u0627\u062F
          \u0627\u0644\u062A\u0627\u0644\u064A\u0629 \u0623\u0643\u0628\u0631 \u0645\u0646
