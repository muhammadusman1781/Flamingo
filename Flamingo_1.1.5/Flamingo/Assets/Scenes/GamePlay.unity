  m_Name: 
  m_EditorClassIdentifier: 
  gradesQuiz:
  - grade: 4
    levels:
    - levelNumber: 1
      questions:
      - question: "\u0623\u064A\u0651\u064C \u0645\u0646 \u0627\u0644\u0643\u0644\u0645\u0627\u062A
          \u0627\u0644\u062A\u0627\u0644\u064A\u0629 \u0627\u0633\u0645\u061F"
        answer:
        - "\u2022 \u064A\u0643\u062A\u0628"
        - "\u2022 \u062C\u0645\u064A\u0644"
        - "\u2022 \u064A\u0631\u0643\u0636"
        - "\u2022 \u064A\u0623\u0643\u0644"
        rightAnswer: "\u2022 \u062C\u0645\u064A\u0644"
      - question: "\u0645\u0627 \u0645\u0635\u062F\u0631 \u0627\u0644\u0637\u0627\u0642\u0629
          \u0627\u0644\u0630\u064A \u064A\u0639\u062A\u0645\u062F \u0639\u0644\u0649
          \u0628\u0642\u0627\u064A\u0627 \u0627\u0644\u0643\u0627\u0626\u0646\u0627\u062A
          \u0627\u0644\u062D\u064A\u0629 \u0627\u0644\u0642\u062F\u064A\u0645\u0629\u061F"
        answer:
        - "\u2022 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0634\u0645\u0633\u064A\u0629"
        - "\u2022 \u0637\u0627\u0642\u0629 \u0627\u0644\u0631\u064A\u0627\u062D"
        - "\u2022 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0627\u0626\u064A\u0629"
        - "\u2022 \u0627\u0644\u0648\u0642\u0648\u062F \u0627\u0644\u0623\u062D\u0641\u0648\u0631\u064A"
        rightAnswer: "\u2022 \u0627\u0644\u0648\u0642\u0648\u062F \u0627\u0644\u0623\u062D\u0641\u0648\u0631\u064A"
      - question: What is the capital of Iraq?
        answer:
        - London
        - Basra
        - Baghdad
        - Mosul
        rightAnswer: Baghdad
      - question: "\u0627\u0644\u0633\u0624\u0627\u06441:"
        answer:
        - "\u0645\u0627 \u0645\u0639\u0646\u0649 \u0643\u0644\u0645\u0629 \"\u0627\u0644\u0642\u064A\u0651\u0648\u0645\"\u061F"
        - "\u2022 \u0627\u0644\u0642\u0627\u0626\u0645 \u0639\u0644\u0649 \u0634\u0624\u0648\u0646
          \u0627\u0644\u062E\u0644\u0642"
