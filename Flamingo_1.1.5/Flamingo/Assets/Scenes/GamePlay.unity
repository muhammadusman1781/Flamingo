      questions:
      - question: "\u0645\u0627 \u0627\u0644\u0646\u0639\u0645\u0629 \u0627\u0644\u062A\u064A
          \u0627\u062E\u062A\u0635\u0651 \u0627\u0644\u0644\u0647 \u0628\u0647\u0627
          \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u062F\u0648\u0646 \u063A\u064A\u0631\u0647
