--- !u!114 &1927127772
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1927127769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 26dfc69fac22a33439c6e5d21851c773, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  gradesQuiz:
  - grade: 7
    levels:
    - levelNumber: 1
      questions:
      - question: "\u0645\u0627 \u0627\u0644\u0646\u0639\u0645\u0629 \u0627\u0644\u062A\u064A
          \u0627\u062E\u062A\u0635\u0651 \u0627\u0644\u0644\u0647 \u0628\u0647\u0627
          \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u062F\u0648\u0646 \u063A\u064A\u0631\u0647
          \u0645\u0646 \u0627\u0644\u0645\u062E\u0644\u0648\u0642\u0627\u062A\u061F"
        answer:
        - "\u0627\u0644\u0633\u0645\u0639"
        - "\u0627\u0644\u0628\u0635\u0631"
        - "c) \u0627\u0644\u0639\u0642\u0644"
        - "\u0627\u0644\u062D\u0631\u0643\u0629"
        rightAnswer: "c) \u0627\u0644\u0639\u0642\u0644"
      - question: "\u0645\u0627 \u0648\u0638\u064A\u0641\u0629 \u0627\u0644\u0645\u062C\u0647\u0631\u061F"
        answer:
        - "\u062A\u0643\u0628\u064A\u0631 \u0635\u0648\u0631\u0629 \u0627\u0644\u0623\u062C\u0633\u0627\u0645
          \u0627\u0644\u062F\u0642\u064A\u0642\u0629"
        - "\u062A\u0642\u0648\u064A\u0629 \u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u0633\u0627\u0642\u0637"
        - "\u062A\u0635\u063A\u064A\u0631 \u0627\u0644\u0623\u062C\u0633\u0627\u0645
          \u0627\u0644\u0643\u0628\u064A\u0631\u0629"
        - "\u062A\u0633\u0631\u064A\u0639 \u062D\u0631\u0643\u0629 \u0627\u0644\u062C\u0632\u064A\u0626\u0627\u062A"
        rightAnswer: "\u062A\u0643\u0628\u064A\u0631 \u0635\u0648\u0631\u0629 \u0627\u0644\u0623\u062C\u0633\u0627\u0645
          \u0627\u0644\u062F\u0642\u064A\u0642\u0629"
      - question: "\u0645\u0627 \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u062A\u064A
          \u062A\u0643\u0648\u0646 \u0641\u064A\u0647\u0627 \u0627\u0644\u062C\u0632\u064A\u0626\u0627\u062A
          \u0645\u062A\u0631\u0627\u0635\u0629 \u0648\u0623\u0648\u0627\u0635\u0631\u0647\u0627
          \u0642\u0648\u064A\u0629\u061F"
        answer:
        - "\u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u063A\u0627\u0632\u064A\u0629"
        - "\u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u0633\u0627\u0626\u0644\u0629"
        - "c) \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u0635\u0644\u0628\u0629"
        - "\u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u0628\u0644\u0627\u0632\u0645\u064A\u0629"
        rightAnswer: "c) \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u0635\u0644\u0628\u0629"
      - question: What does  Hello  mean in Arabic?
        answer:
        - "\u0648\u062F\u0627\u0639\u0627\u064B"
        - "b. \u0645\u0631\u062D\u0628\u0627\u064B"
        - "\u0635\u0628\u0627\u062D \u0627\u0644\u062E\u064A\u0631"
        - "\u0634\u0643\u0631\u0627\u064B"
        rightAnswer: "b. \u0645\u0631\u062D\u0628\u0627\u064B"
      - question: "\u0645\u0627 \u0633\u0628\u0628 \u0639\u0630\u0627\u0628 \u0623\u0635\u062D\u0627\u0628
          \u0627\u0644\u0623\u062E\u062F\u0648\u062F\u061F"
        answer:
        - "\u0627\u0644\u0633\u0631\u0642\u0629"
        - "\u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u0628\u0627\u0644\u0644\u0647"
        - "\u0627\u0644\u062A\u0643\u0628\u0631"
        - "\u0627\u0644\u063A\u0634"
        rightAnswer: "\u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u0628\u0627\u0644\u0644\u0647"
      - question: "\u0623\u064A \u0645\u0646 \u0627\u0644\u0623\u0639\u062F\u0627\u062F
          \u0627\u0644\u062A\u0627\u0644\u064A\u0629 \u0647\u0648 \u0639\u062F\u062F
          \u0646\u0633\u0628\u064A\u061F"
        answer:
        - "\u03C0"
        - "\u221A2"
        - 5/7
        - "\u0627\u0644\u062C\u0630\u0631 \u0627\u0644\u062A\u0631\u0628\u064A\u0639\u064A
          \u0644\u0640 3"
