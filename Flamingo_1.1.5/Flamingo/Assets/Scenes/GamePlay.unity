  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 40
    m_FontStyle: 1
    m_BestFit: 1
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.3
  m_Text: "The green of Andalusia and the blood of bullfighters.\n In the land of
    passion and palaces, the Emerald Feather was hidden among the poets\u2019 journals
    and the knights\u2019 swords.\n It is the jewel of ancient Andalusia, shining
    in the hearts of those who lived with passion and fought with honor.\n Only those
    who dance with challenge like a flamenco can earn it.\n Claim it in Spain mode,
    and become the echo of unforgettable glory."
