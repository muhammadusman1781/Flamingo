          \u0648\u0644\u064A\u0633 \u0644\u0647 \u0634\u062D\u0646\u0629\u061F"
        answer:
        - "\u0627\u0644\u0628\u0631\u0648\u062A\u0648\u0646"
        - "b) \u0627\u0644\u0646\u064A\u0648\u062A\u0631\u0648\u0646"
        - "\u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646"
        - "\u0627\u0644\u0623\u064A\u0648\u0646"
        rightAnswer: "b) \u0627\u0644\u0646\u064A\u0648\u062A\u0631\u0648\u0646"
      - question: "\u0639\u0646\u062F  \u062A\u062B\u0628\u064A\u062A  \u0627\u0644\u062D\u062C\u0645 
          \u0648\u0632\u064A\u0627\u062F\u0629  \u0627\u0644\u0643\u062A\u0644\u0629\u060C 
          \u0641\u0625\u0646  \u0627\u0644\u0643\u062B\u0627\u0641\u0629:"
        answer:
        - "\u062A\u0642\u0644"
        - "\u062A\u0628\u0642\u0649  \u062B\u0627\u0628\u062A\u0629"
        - "\u062A\u0632\u062F\u0627\u062F"
        - "\u0644\u0627  \u062A\u062A\u063A\u064A\u0631"
        rightAnswer: "\u062A\u0632\u062F\u0627\u062F"
    - levelNumber: 250
      questions:
      - question: "\"\u062E\u0631\u062C \u0627\u0644\u0642\u0637\u0627\u0631 \u0645\u0633\u0631\u0639\u064B\u0627\"
          \"\u0645\u0633\u0631\u0639\u064B\u0627\" \u062A\u0639\u0631\u0628:"
        answer:
        - "\u0646\u0639\u062A"
        - "b) \u062D\u0627\u0644"
        - "\u0641\u0627\u0639\u0644"
        - "\u0645\u0641\u0639\u0648\u0644 \u0628\u0647"
        rightAnswer: "b) \u062D\u0627\u0644"
      - question: "\u0627\u0644\u0639\u0644\u0627\u0642\u0629  \u0628\u064A\u0646 
          \u0636\u063A\u0637  \u0627\u0644\u063A\u0627\u0632  \u0648\u062D\u062C\u0645\u0647 
          \u0639\u0644\u0627\u0642\u0629:"
        answer:
        - "\u0637\u0631\u062F\u064A\u0629"
        - "\u062B\u0627\u0628\u062A\u0629"
        - "\u0639\u0643\u0633\u064A\u0629"
        - "\u063A\u064A\u0631  \u0645\u062A\u0648\u0642\u0639\u0629"
        rightAnswer: "\u0639\u0643\u0633\u064A\u0629"
