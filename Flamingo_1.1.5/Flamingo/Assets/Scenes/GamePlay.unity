  m_Name: 
  m_EditorClassIdentifier: 
  gradesQuiz:
  - grade: 8
    levels:
    - levelNumber: 1
      questions:
      - question: "\u0645\u0627 \u0646\u0648\u0639 \u0627\u0644\u0646\u0635 \u0627\u0644\u0630\u064A
          \u062A\u0636\u0645\u0646 \u0642\u0635\u0629 (\u0631\u0639\u0627\u064A\u0629
          \u0627\u0644\u0644\u0647 \u0648\u0648\u0639\u062F\u0647)\u061F"
        answer:
        - "\u0634\u0639\u0631"
        - "\u0642\u0635\u0629 \u0642\u0635\u064A\u0631\u0629"
        - "\u0622\u064A\u0629 \u0642\u0631\u0622\u0646\u064A\u0629"
        - "\u0645\u0633\u0631\u062D\u064A\u0629"
        rightAnswer: "\u0622\u064A\u0629 \u0642\u0631\u0622\u0646\u064A\u0629"
      - question: "\u0645\u0627 \u0627\u0644\u0645\u0642\u0635\u0648\u062F \u0628\u0627\u0644\u062A\u0634\u0627\u0628\u0647
          \u0641\u064A \u0627\u0644\u0648\u0638\u064A\u0641\u0629 \u062F\u0648\u0646
          \u0627\u0644\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0623\u0635\u0644
          \u0648\u0627\u0644\u062A\u0643\u0648\u064A\u0646\u061F"
        answer:
        - "\u0627\u0644\u062A\u0628\u0627\u064A\u0646"
        - "\u0627\u0644\u062A\u062C\u0627\u0646\u0633"
        - "\u0627\u0644\u062A\u0634\u0627\u0628\u0647 \u0627\u0644\u0648\u0638\u064A\u0641\u064A"
        - "\u0627\u0644\u062A\u0634\u0627\u0628\u0647 \u0627\u0644\u062A\u0631\u0643\u064A\u0628\u064A"
        rightAnswer: "\u0627\u0644\u062A\u0634\u0627\u0628\u0647 \u0627\u0644\u0648\u0638\u064A\u0641\u064A"
      - question: "\u0645\u0627 \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u062A\u064A
          \u062A\u0643\u0648\u0646 \u0641\u064A\u0647\u0627 \u0627\u0644\u062C\u0633\u064A\u0645\u0627\u062A
          \u0645\u062A\u0628\u0627\u0639\u062F\u0629 \u062C\u062F\u0627\u064B \u0648\u062A\u062A\u062D\u0631\u0643
          \u0628\u062D\u0631\u064A\u0629\u061F"
        answer:
        - "\u2022 \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u0635\u0644\u0628\u0629"
        - "\u2022 \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u0633\u0627\u0626\u0644\u0629"
        - "\u2022 \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u063A\u0627\u0632\u064A\u0629"
        - "\u2022 \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u0628\u0644\u0627\u0632\u0645\u064A\u0629"
        rightAnswer: "\u2022 \u0627\u0644\u062D\u0627\u0644\u0629 \u0627\u0644\u063A\u0627\u0632\u064A\u0629"
      - question: What does the word "cartoons" mean?
        answer:
        - Short, funny stories
        - Reports about school events
        - Writing with words that rhyme
        - Funny stories with small pictures
        rightAnswer: Funny stories with small pictures
      - question: "\u0645\u0627 \u0645\u0639\u0646\u0649 \"\u0627\u0644\u0622\u064A\u0629\"
          \u0641\u064A \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064A\u0645\u061F"
        answer:
        - "a. \u0627\u0644\u0645\u0639\u062C\u0632\u0629 \u0623\u0648 \u0627\u0644\u0639\u0644\u0627\u0645\u0629"
        - "\u0627\u0644\u0642\u0635\u0629"
        - "\u0627\u0644\u062D\u0643\u0627\u064A\u0629"
        - "\u0627\u0644\u062D\u0643\u0645\u0629"
        rightAnswer: "a. \u0627\u0644\u0645\u0639\u062C\u0632\u0629 \u0623\u0648
          \u0627\u0644\u0639\u0644\u0627\u0645\u0629"
      - question: "\u0623\u064A \u0645\u0646 \u0627\u0644\u0623\u0639\u062F\u0627\u062F
          \u0627\u0644\u062A\u0627\u0644\u064A\u0629 \u064A\u0645\u062B\u0644 \u0639\u062F\u062F\u064B\u0627
          \u0646\u0633\u0628\u064A\u064B\u0627\u061F"
        answer:
        - "\u25CF \u221A5"
        - "\u25CF 1.25"
        - "\u25CF \u03C0"
        - "\u25CF 7/0"
        rightAnswer: "\u25CF 1.25"
      - question: "\u0645\u0627 \u0648\u062D\u062F\u0629 \u0642\u064A\u0627\u0633
          \u0627\u0644\u0633\u0631\u0639\u0629 \u0641\u064A \u0627\u0644\u0646\u0638\u0627\u0645
          \u0627\u0644\u062F\u0648\u0644\u064A\u061F"
        answer:
        - "\u2022 m"
        - "\u2022 m/s\xB2"
        - m/s
        - "\u2022 cm/s"
        rightAnswer: m/s
      - question: "\u0645\u0627 \u0647\u0648 \u0633\u0628\u0628 \u062A\u0646\u0648\u0639
          \u0627\u0644\u062A\u0636\u0627\u0631\u064A\u0633 \u0641\u064A \u0627\u0644\u0639\u0631\u0627\u0642\u061F"
        answer:
        - "\u0627\u062E\u062A\u0644\u0627\u0641 \u062F\u0631\u062C\u0627\u062A \u0627\u0644\u062D\u0631\u0627\u0631\u0629"
        - "b) \u062A\u0646\u0648\u0639 \u0627\u0644\u062D\u0631\u0643\u0627\u062A
          \u0627\u0644\u0628\u0627\u0637\u0646\u064A\u0629"
        - "\u0648\u0641\u0631\u0629 \u0627\u0644\u0645\u064A\u0627\u0647"
        - "\u0642\u0631\u0628\u0647 \u0645\u0646 \u0627\u0644\u0628\u062D\u0631"
        rightAnswer: "b) \u062A\u0646\u0648\u0639 \u0627\u0644\u062D\u0631\u0643\u0627\u062A
          \u0627\u0644\u0628\u0627\u0637\u0646\u064A\u0629"
    - levelNumber: 2
